PORT=
ENVIRONMENT=

# Solo la region. Las credenciales de AWS NO se configuran aqui: el SDK las
# resuelve por la cadena estandar (AWS CLI / perfil / rol de IAM).
AWS_REGION=
# Nombre de la funcion Lambda del relay para aviso async tras escribir en
# outbox. Vacio = aviso desactivado (el Scheduler de 1 min lo recoge).
RELAY_FUNCTION_NAME=
EVENT_BUS_NAME=
PORTAL_BASE_URL=
AWS_RDS_POSTGRES_URL=

# POSTGRES
POSTGRES_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# JWT (login, HS256). Generar con: openssl rand -base64 32
# Minimo 32 caracteres. Nunca versionar valores reales.
JWT_SECRET=
# Claims iss/aud del access token. Vacios aplican kenko-auth / kenko-api.
JWT_ISSUER=
JWT_AUDIENCE=
# CORS: lista separada por comas. Vacio aplica defaults de desarrollo
# (http://localhost|127.0.0.1 en 3000,3001,3100,5000,5500,8000,8080).
# En produccion fijar dominios https reales, ej: CORS_ORIGINS=https://app.kenko.com
CORS_ORIGINS=