PORT=
ENVIRONMENT=

# Solo la region. Las credenciales de AWS NO se configuran aqui: el SDK las
# resuelve por la cadena estandar (AWS CLI / perfil / rol de IAM).
AWS_REGION=
EVENT_BUS_NAME=
PORTAL_BASE_URL=
AWS_RDS_POSTGRES_URL=

# POSTGRES
POSTGRES_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# JWT (login, HS256). Generar con: openssl rand -base64 32
# Minimo 32 caracteres. Nunca versionar valores reales.
JWT_SECRET=
# Claims iss/aud del access token. Vacios aplican kenko-auth / kenko-api.
JWT_ISSUER=
JWT_AUDIENCE=