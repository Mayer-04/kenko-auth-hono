PORT=
ENVIRONMENT=

# Solo la region. Las credenciales de AWS NO se configuran aqui: el SDK las
# resuelve por la cadena estandar (AWS CLI / perfil / rol de IAM).
AWS_REGION=
EVENT_BUS_NAME=kenko-dev-bus
AWS_RDS_POSTGRES_URL=

# POSTGRES
POSTGRES_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT (HS256). El secreto vive solo en `.env` local, nunca en el repositorio.
# En produccion debe tener al menos 32 caracteres aleatorios.
JWT_SECRET=
JWT_ISSUER=kenko.auth
JWT_AUDIENCE=kenko-api